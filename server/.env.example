# PostgreSQL connection string used by Prisma at runtime.
# If using a pooled connection (e.g. Neon's "-pooler" endpoint, PgBouncer,
# RDS Proxy), also set DIRECT_URL below to an unpooled connection for
# migrations — see the comment on `directUrl` in schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncba_peoplesuite?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ncba_peoplesuite?schema=public"

# HTTP port the NestJS API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the Next.js client)
CORS_ORIGIN="http://localhost:3000"

# Base URL of the Next.js client — used to build links inside outgoing
# emails (e.g. the "Log in to PeopleSuite" button). Falls back to the first
# CORS_ORIGIN entry if unset.
CLIENT_APP_URL="http://localhost:3000"

# Outgoing email (Email Notification & Automation module) — Gmail SMTP via
# an App Password, never a real Google account password, and never
# committed to source. Leave these unset in local dev: MailerService then
# reports itself as unconfigured and EmailQueueProcessor marks queued
# emails FAILED with a clear reason instead of retrying forever or
# crashing the app on boot.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="NCBA Rwanda PeopleSuite <no-reply@ncbarwanda.com>"

# Shown in every outgoing email's footer ("Questions? Contact NCBA Rwanda
# Human Resource at ..."). Falls back to +250 780 503 242 if unset — see
# EmailService.buildGlobalVariables().
HR_CONTACT_PHONE="+250 780 503 242"

# AI HR Administration Assistant — which provider answers chat requests.
#   "anthropic" (default) — hosted Claude via the Anthropic API.
#   "ollama"              — a self-hosted open-source model, no API key,
#                            no per-token cost, nothing leaves your network.
# Leave AI_PROVIDER unset to use Anthropic. Whichever provider is selected,
# if it isn't reachable/configured the assistant answers with a setup notice
# instead of crashing (see llm/anthropic-client.service.ts and
# llm/ollama-client.service.ts).
AI_PROVIDER="anthropic"

# --- Anthropic (used when AI_PROVIDER=anthropic) ---
# API key from console.anthropic.com.
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Ollama (used when AI_PROVIDER=ollama) ---
# Run `ollama serve` and `ollama pull <model>` first — see
# llm/ollama-client.service.ts for setup notes and tradeoffs vs. Claude.
# Both optional — these are the defaults if unset.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# --- Seed — HR Head (admin) employee -----------------------------------
# prisma/seed.ts creates exactly one employee: the Head of Human Resource
# Department, who gets admin access automatically (Human Resources is the
# one department that does — see HR_DEPARTMENT_NAME in
# src/common/admin-eligibility.util.ts). These personal fields are
# deliberately NOT hardcoded in seed.ts — set the required ones below
# before running `npx prisma db seed`, or it will fail fast with a clear
# error naming whichever var is missing.
#
# Required — no fallback:
SEED_HR_HEAD_PHONE=""
SEED_HR_HEAD_NATIONAL_ID=""
# Format: YYYY-MM-DD
SEED_HR_HEAD_DATE_OF_BIRTH=""
#
# Optional — sensible defaults if unset:
SEED_HR_HEAD_EMAIL="mwanafunzifabrice@gmail.com"
# Falls back to DEFAULT_EMPLOYEE_PASSWORD ("Staff@123", same default every
# other new hire gets) if unset — mustChangePassword forces a change on
# first login regardless.
SEED_HR_HEAD_PASSWORD=""
SEED_HR_HEAD_GENDER="MALE"
SEED_HR_HEAD_MARITAL_STATUS="SINGLE"
SEED_HR_HEAD_NATIONALITY="Rwandan"
