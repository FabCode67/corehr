# PostgreSQL connection string used by Prisma at runtime.
# If using a pooled connection (e.g. Neon's "-pooler" endpoint, PgBouncer,
# RDS Proxy), also set DIRECT_URL below to an unpooled connection for
# migrations — see the comment on `directUrl` in schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncba_peoplesuite?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ncba_peoplesuite?schema=public"

# HTTP port the NestJS API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the Next.js client)
CORS_ORIGIN="http://localhost:3000"
