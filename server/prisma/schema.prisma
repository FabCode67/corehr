// NCBA Rwanda PeopleSuite — Organizational Structure schema
//
// Hierarchy: Function -> Department -> Unit (optional) -> Position -> Employee
//
// Design notes:
// - Reporting lines are NEVER hardcoded: Position.reportsToPositionId is a
//   self-relation, so the org chart is generated dynamically at query time
//   (see OrgChartService). Cycle prevention is enforced in PositionsService,
//   not in the schema (Postgres/Prisma can't express "no cycles" declaratively).
// - Position is modelled as a reusable ROLE/TEMPLATE (e.g. "Officer – Channels
//   Analyst"), not a single seat — multiple employees can hold the same
//   Position concurrently. This matches how the spec lists positions as fixed
//   org-chart nodes rather than numbered seats. Revisit if per-seat headcount
//   tracking is needed later.
// - Band is independent of Position (an employee can change position without
//   changing band), per the "Employee Band" requirement.
// - Employee.departmentId/unitId are intentionally NOT stored directly —
//   they're derived via Position -> Unit -> Department to avoid a second
//   source of truth. PositionHistory captures point-in-time position + band
//   for historical/audit purposes (transfers, promotions, reporting changes).
// - Org entities are soft-deleted (isActive) rather than hard-deleted, since
//   historical records (PositionHistory) must keep resolving to a real row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon's "-pooler" endpoint) — used at runtime.
  url = env("DATABASE_URL")
  // Direct/unpooled connection — used only for migrations. Connection
  // poolers running in transaction mode (PgBouncer et al., which is what
  // Neon's pooler endpoint uses) don't support the session-level advisory
  // locks `prisma migrate` needs, so migrations must go through the direct
  // endpoint even though the app itself talks to the pooled one.
  directUrl = env("DIRECT_URL")
}

enum PositionTrack {
  STANDARD // Intern -> Head of Department ladder, used by ordinary departments
  EXECUTIVE // MD, CEO, COO, CTO, CFO, other executives — Executive Management only
}

/// Per the Employee Registration spec: an employee is ACTIVE from creation
/// until they go through Exit Management, at which point this flips to
/// EXIT. Employee rows are never deleted — this status (kept in lockstep
/// with `isActive`, see comment on that field) is the durable historical
/// record instead.
enum EmploymentStatus {
  ACTIVE
  EXIT
}

enum PositionChangeType {
  INITIAL_HIRE
  PROMOTION
  DEMOTION
  TRANSFER
  REPORTING_LINE_CHANGE
  BAND_CHANGE
  RESTRUCTURE
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum ContractType {
  PERMANENT
  TEMPORARY
  GRADUATE_TRAINEE
  INTERN
}

/// DEPRECATED — superseded by the Branch model below (admin-manageable
/// locations). Kept only so `npm run prisma:seed` can read each existing
/// employee's historical value and backfill Employee.branchId from it.
/// Safe to delete, along with Employee.workLocation, in a later cleanup
/// migration once every environment has been reseeded at least once.
enum WorkLocation {
  HEADQUARTERS
  KIGALI_HEIGHTS_BRANCH
  DOWNTOWN_BRANCH
  REMERA_BRANCH
  NYABUGOGO_BRANCH
  GISOZI_BRANCH
  RUSIZI_BRANCH
  MUSANZE_BRANCH
  KAYONZA_BRANCH
  RUBAVU_BRANCH
}

enum EducationType {
  DEGREE
  DIPLOMA
  CERTIFICATE
  PROFESSIONAL_CERTIFICATION
  TRAINING
  COURSE
  WORKSHOP
}

enum ExitReason {
  RESIGNATION
  TERMINATION
  END_OF_CONTRACT
}

/// Whether the bank would have preferred to retain this employee — an HR
/// analytics signal distinct from ExitReason (e.g. a resignation can still
/// be Regrettable).
enum ExitType {
  REGRETTABLE
  NON_REGRETTABLE
}

/// Top-level business grouping (Executive Management, Technology Function, ...)
model Function {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)

  departments Department[]
  requiredForCourses Course[]
  jobRequisitions JobRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("functions")
}

/// A Department belongs to exactly one Function. May or may not have Units.
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  functionId  String   @db.Uuid
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)

  function  Function   @relation(fields: [functionId], references: [id])
  units     Unit[]
  positions Position[] // positions attached directly (department has no units)
  performanceReviews PerformanceReview[]
  requiredForCourses Course[]
  courseAssignments  CourseAssignment[]
  workforcePlans     WorkforcePlan[]
  jobRequisitions    JobRequisition[]
  offers             Offer[]
  formTemplates      FormTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([functionId, name])
  @@map("departments")
}

/// A Unit is an optional sub-grouping within a Department.
model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  departmentId String  @db.Uuid
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)

  department Department @relation(fields: [departmentId], references: [id])
  positions  Position[]
  performanceReviews PerformanceReview[]
  requiredForCourses Course[]
  courseAssignments  CourseAssignment[]
  workforcePlans     WorkforcePlan[]
  jobRequisitions    JobRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@map("units")
}

/// Admin-manageable work location (headquarters or a branch) — replaces the
/// old fixed WorkLocation enum so branches can be added/retired without a
/// code change. Exactly one row should have isHeadquarters = true;
/// BranchesService blocks deactivating/deleting it.
model Branch {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @unique
  code           String? @unique
  isHeadquarters Boolean @default(false)
  isActive       Boolean @default(true)

  employees Employee[]
  performanceReviews PerformanceReview[]
  courseAssignments  CourseAssignment[]
  workforcePlans     WorkforcePlan[]
  jobRequisitions    JobRequisition[]
  jobPostings        JobPosting[]
  offers             Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

/// Lookup table for position ranks (Intern..Head of Department, plus the
/// separate Executive track). Kept data-driven so new levels/tracks don't
/// require a code change.
model PositionLevel {
  id    String        @id @default(uuid()) @db.Uuid
  name  String        @unique
  /// Short badge shown on org-chart cards (e.g. "E1" for Managing
  /// Director, "F2" for Senior Manager). Optional — purely presentational,
  /// falls back to `name` in the UI when unset.
  code  String?       @unique
  rank  Int           @unique
  track PositionTrack @default(STANDARD)

  positions Position[]
  performanceReviews PerformanceReview[]
  requiredForCourses Course[]
  courseAssignments  CourseAssignment[]
  jobDescriptions    JobDescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("position_levels")
}

/// A Position is a role/job template. It belongs to a Department, and
/// optionally to a Unit within that department (unitId is null when the
/// department has no units). Reporting lines are expressed purely through
/// reportsToPositionId — a self-relation — so the tree is fully dynamic.
model Position {
  id           String  @id @default(uuid()) @db.Uuid
  title        String
  departmentId String  @db.Uuid
  unitId       String? @db.Uuid
  levelId      String  @db.Uuid

  // Nullable only for the single root of the tree (e.g. Managing Director).
  reportsToPositionId String? @db.Uuid

  isActive Boolean @default(true)

  department Department      @relation(fields: [departmentId], references: [id])
  unit       Unit?           @relation(fields: [unitId], references: [id])
  level      PositionLevel   @relation(fields: [levelId], references: [id])
  reportsTo  Position?       @relation("PositionReportsTo", fields: [reportsToPositionId], references: [id])
  directReports Position[]   @relation("PositionReportsTo")

  employees       Employee[]
  positionHistory PositionHistory[]
  performanceReviews PerformanceReview[]
  requiredForCourses Course[]
  courseAssignments  CourseAssignment[]
  jobRequisitions        JobRequisition[] @relation("RequisitionPosition")
  requisitionsReportingTo JobRequisition[] @relation("RequisitionReportsTo")
  offers                 Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: Postgres treats each NULL as distinct, so this constraint does not
  // stop two department-level positions (unitId = NULL) from sharing a
  // title. Department-level title uniqueness is enforced in
  // PositionsService instead. See also: unit.departmentId must match
  // department Id when unitId is set — enforced in the same service.
  @@unique([departmentId, unitId, title])
  @@index([reportsToPositionId])
  @@map("positions")
}

/// Employee grade, independent of Position. Every employee (including
/// executives) has exactly one current Band.
model Band {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  rank        Int     @unique
  description String?
  isActive    Boolean @default(true)

  employees       Employee[]
  positionHistory PositionHistory[]
  performanceReviews PerformanceReview[]
  requiredForCourses Course[]
  courseAssignments  CourseAssignment[]
  jobRequisitions    JobRequisition[]
  jobDescriptions    JobDescription[]
  offers             Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bands")
}

/// Full Employee record built around the multi-step Employee Registration
/// wizard. Only the "Basic Information" fields are required at creation —
/// everything else (employment details, position assignment, family,
/// education) is optional and filled in later, one step at a time, without
/// blocking the record from existing. See EmployeesService for how each
/// wizard step persists independently (this is what gives the wizard its
/// "leave and resume later" behaviour — there's no separate draft store,
/// the Employee row itself *is* the draft until every step is filled in).
model Employee {
  /// The Staff ID — auto-generated by EmployeesService (EMP-0001, EMP-0002,
  /// ...), never entered manually (see the employeeNumber generation comment
  /// there). This is the employee's primary key and the identifier every
  /// other table's employee-relation columns store and join on, replacing
  /// the internal UUID this model used to key on.
  employeeNumber String @id

  // --- Step 1: Basic Information (required) ---
  firstName         String
  middleName        String?
  lastName          String
  preferredName     String?
  gender            Gender
  dateOfBirth       DateTime
  nationalIdNumber  String        @unique
  nationality       String
  maritalStatus     MaritalStatus
  email             String        @unique
  phone             String
  /// DEPRECATED — see the enum's doc comment. New code reads/writes
  /// branchId below instead.
  workLocation      WorkLocation?
  /// Nullable at the DB level only so this migration stays purely additive
  /// on the already-populated employees table (same reasoning as
  /// passwordHash above) — EmployeesService.create() always sets it via
  /// CreateEmployeeDto, which requires it, so in practice every employee
  /// created from here on has one. Existing rows are backfilled from
  /// workLocation by the seed script.
  branchId          String?       @db.Uuid
  profilePictureUrl String?

  // --- Auth ---
  /// bcrypt hash, set to a hash of the default password ("Staff@123") by
  /// EmployeesService.create() and changed via AuthService.changePassword().
  /// Nullable only so the migration adding this column doesn't require a
  /// backfill on already-seeded rows — `npm run prisma:seed` backfills it
  /// for existing demo employees, and every employee created through the
  /// app from here on always gets one. NEVER returned by the API: see the
  /// global `omit` config in PrismaService.
  passwordHash String?
  /// Grants access to the Admin portal (see middleware.ts). Defaults to
  /// false — HR/IT sets this manually (e.g. via seed) for the handful of
  /// people who administer the system; every other employee is staff-only.
  isAdmin      Boolean @default(false)

  // --- Step 2: Employment Details (optional) ---
  contractType        ContractType?
  employmentStartDate DateTime?
  /// Mandatory for PERMANENT contracts — EmployeesService defaults this to
  /// employmentStartDate + 3 months when left unset, and HR can extend it
  /// later by editing the field again. Not used for TEMPORARY (see
  /// contractEndDate instead).
  probationEndDate DateTime?
  /// The contract's end date for TEMPORARY hires (Permanent/Graduate
  /// Trainee/Intern don't use this) — set alongside employmentStartDate,
  /// and can be pushed out later ("expanded") by HR editing the field.
  contractEndDate          DateTime?
  previousEmployee         Boolean       @default(false)
  previousEmployeeNumber   String?
  previousPositionHeld     String?
  previousDepartment       String?
  previousExitDate         DateTime?
  previousReasonForLeaving String?

  // --- Step 3: Position Assignment (optional) ---
  // Nullable: an employee can exist with basic info only, before ever being
  // placed on the org chart. Once set, PositionHistory (below) tracks every
  // change from here on, same as before.
  positionId String? @db.Uuid
  bandId     String? @db.Uuid

  // The reporting manager is derived automatically from
  // position.reportsToPositionId wherever possible (see ReportingService).
  // This override exists only for documented exceptions (e.g. dotted-line
  // reporting, or a parent position that's temporarily vacant) — leave null
  // to use automatic derivation.
  reportingManagerOverrideId String?

  // --- Step 4: Family Information (optional) ---
  // Partner is inlined (an employee has at most one on record) — Children
  // is a genuine one-to-many, modelled as EmployeeChild below.
  partnerName        String?
  partnerPhone       String?
  partnerDateOfBirth DateTime?

  employmentStatus EmploymentStatus @default(ACTIVE)
  /// Kept in lockstep with employmentStatus (ACTIVE <-> true, EXIT <->
  /// false) by EmployeesService so every existing isActive:true filter
  /// across Positions/OrgChart/Employees keeps working unchanged, while
  /// employmentStatus is the source of truth the UI shows per spec.
  isActive Boolean @default(true)

  // --- Exit Management (set once, by EmployeesService.processExit) -------
  exitDate     DateTime?
  exitReason   ExitReason?
  exitType     ExitType?
  nextMove     String?
  exitComments String?

  position                 Position?  @relation(fields: [positionId], references: [id])
  band                     Band?      @relation(fields: [bandId], references: [id])
  branch                   Branch?    @relation(fields: [branchId], references: [id])
  reportingManagerOverride Employee?  @relation("ReportingOverride", fields: [reportingManagerOverrideId], references: [employeeNumber])
  managedOverrides         Employee[] @relation("ReportingOverride")

  positionHistory PositionHistory[]
  children        EmployeeChild[]
  education       EmployeeEducation[]

  // --- Leave Management ---------------------------------------------------
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]      @relation("LeaveRequester")
  delegateOnRequests LeaveRequest[]      @relation("LeaveDelegate")
  approvalActions    LeaveApproval[]
  notifications      Notification[]

  // --- Performance Management ----------------------------------------------
  performanceReviewsAsSubject  PerformanceReview[]     @relation("PerformanceSubject")
  performanceReviewsAsReviewer PerformanceReview[]     @relation("PerformanceReviewer")
  performanceAuditLogs         PerformanceAuditLog[]

  // --- Learning & Development ----------------------------------------------
  courseAssignments         CourseAssignment[] @relation("CourseAssignee")
  courseAssignmentsAssigned CourseAssignment[] @relation("CourseAssigner")
  courseAssignmentsVerified CourseAssignment[] @relation("CourseVerifier")
  courseAuditLogs           CourseAuditLog[]

  // --- Recruitment Management -----------------------------------------------
  workforcePlansAsHiringManager WorkforcePlan[]         @relation("PlanHiringManager")
  workforcePlansAsRecruiter     WorkforcePlan[]         @relation("PlanRecruiter")
  workforcePlansApproved        WorkforcePlan[]         @relation("PlanApprover")
  requisitionsRequested         JobRequisition[]        @relation("RequisitionRequester")
  requisitionsAsHiringManager   JobRequisition[]        @relation("RequisitionHiringManager")
  requisitionsAsRecruiter       JobRequisition[]        @relation("RequisitionRecruiter")
  requisitionsApproved          JobRequisition[]        @relation("RequisitionApprover")
  jobDescriptionsAsReportingManager JobDescription[]    @relation("JobDescriptionReportingManager")
  recruitmentStagesOwned        RecruitmentStageInstance[] @relation("StageOwner")
  screeningsDecided             Screening[]             @relation("ScreeningDecider")
  assessmentsEvaluated          Assessment[]            @relation("AssessmentEvaluator")
  interviewPanelMemberships     InterviewPanelist[]     @relation("InterviewPanelist")
  offersCreated                 Offer[]                 @relation("OfferCreator")
  onboardingTasksCompleted      OnboardingTask[]        @relation("OnboardingTaskCompleter")
  recruitmentAuditLogs          RecruitmentAuditLog[]   @relation("RecruitmentAuditActor")
  /// Set on the Employee row created when this candidate's onboarding is
  /// completed — see the module doc comment on Application.hiredEmployeeNumber.
  hiredFromApplication           Application?

  // --- Forms Management ------------------------------------------------------
  formTemplatesCreated   FormTemplate[]  @relation("FormTemplateCreator")
  formInstancesOwned     FormInstance[]  @relation("FormInstanceEmployee")
  formInstancesAssigned  FormInstance[]  @relation("FormInstanceAssigner")
  formSignatures         FormSignature[] @relation("FormSigner")
  formStagesAsApprover   FormSignatureStage[] @relation("FormStageSpecificApprover")
  formAuditLogs          FormAuditLog[]  @relation("FormAuditActor")

  // --- Employee Relations -----------------------------------------------------
  disciplinaryCasesAsSubject  DisciplinaryCase[]          @relation("DisciplinaryCaseEmployee")
  disciplinaryCasesReported   DisciplinaryCase[]          @relation("DisciplinaryCaseReporter")
  disciplinaryMeetingsCreated DisciplinaryMeeting[]       @relation("MeetingCreator")
  investigationsConducted     Investigation[]             @relation("Investigator")
  sanctionsReceived           Sanction[]                  @relation("SanctionEmployee")
  sanctionsIssued             Sanction[]                  @relation("SanctionIssuer")
  sanctionsApproved           Sanction[]                  @relation("SanctionApprover")
  grievancesSubmitted         Grievance[]                 @relation("GrievanceSubmitter")
  grievancesAssigned          Grievance[]                 @relation("GrievanceAssignee")
  appealsSubmitted            Appeal[]                    @relation("AppealEmployee")
  appealsDecided              Appeal[]                    @relation("AppealDecider")
  employeeRelationsAuditLogs  EmployeeRelationsAuditLog[] @relation("ERAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

/// Step 4 (Family Information): unlimited children per employee, added
/// dynamically in the UI.
model EmployeeChild {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String
  fullName    String
  dateOfBirth DateTime
  gender      Gender

  employee Employee @relation(fields: [employeeId], references: [employeeNumber], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_children")
}

/// Step 5 (Education & Professional Development): unlimited
/// degrees/diplomas/certifications/training records per employee.
model EmployeeEducation {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String
  type           EducationType
  title          String
  institution    String
  fieldOfStudy   String?
  grade          String?
  startDate      DateTime
  endDate        DateTime?
  certificateUrl String?
  description    String?

  employee Employee @relation(fields: [employeeId], references: [employeeNumber], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_education")
}

/// Point-in-time record of an employee's position + band, closed off by
/// effectiveTo when superseded. This is the historical audit trail for
/// transfers, promotions, demotions, band changes, and reporting-line
/// changes required by the "Database Design Considerations" section.
model PositionHistory {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String
  positionId String @db.Uuid
  bandId     String @db.Uuid

  changeType   PositionChangeType
  changeReason String?

  effectiveFrom DateTime
  effectiveTo   DateTime? // null = current

  createdByUserId String? // audit — which admin user (Employee.employeeNumber) made the change
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeNumber])
  position Position @relation(fields: [positionId], references: [id])
  band     Band     @relation(fields: [bandId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("position_history")
}

// =============================================================================
// Leave Management
//
// Design notes:
// - Nothing about leave policy is hardcoded: leave types, entitlements per
//   employee category, sick/compassionate limits & documentation rules,
//   approval workflow steps, and carry-forward rules are all data-driven
//   (LeaveType + its related config tables), editable by HR through the
//   admin panel. Seeded with the spec's defaults, but every number here is
//   just seed data, not a code constant.
// - Day counts are plain Int (whole days) — the spec's examples are all
//   whole-day; revisit with a Decimal if half-day leave is needed later.
// - LeaveBalance is one row per (employee, leaveType, year) and stores the
//   inputs (entitled/carriedForward/adjustment) plus the two derived
//   counters (taken/pending) kept in sync by LeaveRequestsService as
//   requests move through their lifecycle — remaining is always computed,
//   never stored, so it can't drift.
// - The approval workflow is a small state machine: LeaveApprovalStep
//   defines the ordered steps per LeaveType (role-based, not a specific
//   person — LINE_MANAGER resolves via the position hierarchy exactly like
//   EmployeesService.getReportingManager, HR resolves to "any admin-portal
//   user" since there's no separate HR-role login yet). LeaveApproval rows
//   are created for a request at submission time (one per step) and get
//   filled in as each step is actioned.
// =============================================================================

enum LeaveCategory {
  ANNUAL
  MATERNITY
  PATERNITY
  SICK
  COMPASSIONATE
  OTHER
}

/// Maps an employee's contract situation to their Annual Leave entitlement.
/// MANAGING_DIRECTOR is resolved from PositionLevel.code ("E1"), not
/// ContractType, since the MD is a position-based exception, not a
/// contract-type one — see LeaveBalancesService.resolveEntitlementCategory.
enum LeaveEntitlementCategory {
  PERMANENT
  TEMPORARY
  GRADUATE_TRAINEE
  INTERN
  MANAGING_DIRECTOR
}

enum ApprovalRole {
  LINE_MANAGER
  HR
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  LEAVE_STARTING_SOON
  RETURNING_TOMORROW
  LOW_BALANCE
  APPROVAL_NEEDED
  COURSE_ASSIGNED
  COURSE_DUE_SOON
  COURSE_OVERDUE
  CERTIFICATE_APPROVED
  CERTIFICATE_REJECTED
  MANDATORY_TRAINING_INCOMPLETE
  INTERVIEW_SCHEDULED
  OFFER_ACCEPTED
  OFFER_DECLINED
  FORM_ASSIGNED
  FORM_DUE_SOON
  FORM_OVERDUE
  FORM_SIGNATURE_REQUIRED
  FORM_APPROVED
  FORM_REJECTED
  FORM_COMPLETED
  ERC_MEETING_SCHEDULED
  ERC_DECISION_ISSUED
  ERC_APPEAL_DECIDED
  ERC_MANAGER_INPUT_NEEDED
  ERC_INVESTIGATION_OVERDUE
  ERC_APPEAL_SUBMITTED
}

/// A configurable leave type (Annual, Maternity, Paternity, Sick,
/// Compassionate, or any future custom type HR adds).
model LeaveType {
  id       String        @id @default(uuid()) @db.Uuid
  name     String        @unique
  code     String?       @unique
  category LeaveCategory @default(OTHER)
  isActive Boolean       @default(true)

  /// If false, taking this leave does NOT reduce Annual Leave balance
  /// (Maternity/Paternity per spec).
  affectsAnnualBalance Boolean @default(true)
  /// Restricts who can request this type (Maternity -> FEMALE, Paternity
  /// -> MALE). Null = no restriction.
  genderRestriction Gender?

  /// For types with a flat cap not driven by LeaveEntitlementRule (Sick,
  /// Compassionate) — the HR-configurable "maximum days per year".
  maxDaysPerYear Int?
  /// Whether supporting documentation (medical certificate, proof of
  /// bereavement, etc.) is required at all.
  requiresDocumentation Boolean @default(false)
  /// Only required after this many consecutive days — e.g. sick leave over
  /// 3 days needs a certificate, shorter doesn't. Null = always required
  /// (when requiresDocumentation is true) regardless of length.
  documentationThresholdDays Int?
  /// Whether an HR approval step is included in this type's workflow —
  /// mirrored by LeaveApprovalStep rows, kept here too as a quick flag for
  /// the admin UI.
  requiresHrApproval Boolean @default(true)

  entitlementRules  LeaveEntitlementRule[]
  approvalSteps     LeaveApprovalStep[]
  carryForwardRule  LeaveCarryForwardRule?
  balances          LeaveBalance[]
  requests          LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_types")
}

/// Annual Leave entitlement table (spec: Permanent 21 / Temporary 18 / MD
/// 28 / Intern 0) — modelled per LeaveType so any future type can also
/// carry category-based entitlements without a schema change.
model LeaveEntitlementRule {
  id               String                   @id @default(uuid()) @db.Uuid
  leaveTypeId      String                   @db.Uuid
  employeeCategory LeaveEntitlementCategory
  days             Int

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([leaveTypeId, employeeCategory])
  @@map("leave_entitlement_rules")
}

/// One ordered step in a LeaveType's approval workflow (default: Line
/// Manager, then HR — but HR admins can add/remove/reorder steps per type).
model LeaveApprovalStep {
  id          String       @id @default(uuid()) @db.Uuid
  leaveTypeId String       @db.Uuid
  order       Int
  role        ApprovalRole

  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]

  @@unique([leaveTypeId, order])
  @@map("leave_approval_steps")
}

/// Configurable carry-forward policy, one per LeaveType.
model LeaveCarryForwardRule {
  id          String    @id @default(uuid()) @db.Uuid
  leaveTypeId String    @unique @db.Uuid
  enabled     Boolean   @default(false)
  maxDays     Int?
  /// Carried-forward days expire this many days into the following year
  /// (e.g. 90 = expires ~March 31). Null = never expires.
  expiresAfterDays Int?

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_carry_forward_rules")
}

/// Rwanda public holidays — excluded from leave-day calculations.
model PublicHoliday {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  date                DateTime @db.Date
  /// Fixed-date holidays (e.g. Jan 1) repeat every year automatically in
  /// calculations; date-varying ones (e.g. Eid) must be re-entered yearly.
  isRecurringAnnually Boolean  @default(false)
  isActive            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@map("public_holidays")
}

/// Singleton row (id is always 1) holding the bank-wide weekend/working-day
/// configuration used by the leave day-calculator.
model LeaveSettings {
  id                    Int     @id @default(1)
  /// Days of week treated as weekend, JS convention (0=Sun..6=Sat). Default
  /// [0,6] = Saturday & Sunday.
  weekendDays           Int[]   @default([0, 6])
  excludeWeekends       Boolean @default(true)
  excludePublicHolidays Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("leave_settings")
}

/// One row per (employee, leaveType, year) — the source of truth for an
/// employee's leave balance. `remaining` is never stored; it's always
/// entitledDays + carriedForwardDays + adjustmentDays - takenDays -
/// pendingDays, computed on read (see LeaveBalancesService).
model LeaveBalance {
  id                 String @id @default(uuid()) @db.Uuid
  employeeId         String
  leaveTypeId        String @db.Uuid
  year               Int
  entitledDays       Int    @default(0)
  carriedForwardDays Int    @default(0)
  /// HR manual correction (positive or negative) — e.g. compensating for a
  /// system error, or a documented policy exception.
  adjustmentDays Int @default(0)
  takenDays      Int @default(0)
  pendingDays    Int @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [employeeNumber])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String
  leaveTypeId    String              @db.Uuid
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  returnDate     DateTime            @db.Date
  numberOfDays   Int
  reason         String?
  attachmentUrl  String?
  delegateEmployeeId String?
  status         LeaveRequestStatus  @default(SUBMITTED)
  /// Which LeaveApprovalStep.order is currently awaiting action — null once
  /// the request reaches a terminal status (APPROVED/REJECTED/CANCELLED).
  currentStepOrder Int?
  /// Set when HR knowingly approves a request that would otherwise dip the
  /// balance negative.
  hrOverride Boolean @default(false)

  employee Employee @relation("LeaveRequester", fields: [employeeId], references: [employeeNumber])
  delegate Employee? @relation("LeaveDelegate", fields: [delegateEmployeeId], references: [employeeNumber])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

/// One row per approval step for a given request, created up front when the
/// request is submitted (so the full workflow is visible immediately) and
/// filled in (decision/approver/comment/decidedAt) as each step is acted on.
model LeaveApproval {
  id                  String            @id @default(uuid()) @db.Uuid
  leaveRequestId      String            @db.Uuid
  stepId              String            @db.Uuid
  order               Int
  role                ApprovalRole
  decision            ApprovalDecision?
  approverEmployeeId  String?
  comment             String?
  decidedAt           DateTime?

  leaveRequest LeaveRequest      @relation(fields: [leaveRequestId], references: [id])
  step         LeaveApprovalStep @relation(fields: [stepId], references: [id])
  approver     Employee?         @relation(fields: [approverEmployeeId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@unique([leaveRequestId, order])
  @@map("leave_approvals")
}

model Notification {
  id                 String           @id @default(uuid()) @db.Uuid
  recipientEmployeeId String
  type               NotificationType
  title              String
  message            String
  isRead             Boolean          @default(false)
  relatedLeaveRequestId String?       @db.Uuid

  recipient          Employee      @relation(fields: [recipientEmployeeId], references: [employeeNumber])
  relatedLeaveRequest LeaveRequest? @relation(fields: [relatedLeaveRequestId], references: [id])

  createdAt DateTime @default(now())

  @@index([recipientEmployeeId, isRead])
  @@map("notifications")
}

// =============================================================================
// Performance Management
//
// Design notes:
// - PerformanceRatingScale is a data-driven lookup (rank 1-5 + editable
//   label/description), same "no code change to relabel" pattern as Band and
//   PositionLevel. PerformanceReview.overallRating stores the plain Int rank
//   rather than an FK, deliberately decoupled — a historical review's rating
//   must keep meaning exactly what it meant when it was given even if HR
//   later edits a label, and a permanent record should never be able to
//   dangle if a scale row were ever removed.
// - PerformanceReviewPeriod is one row per performance year (e.g. "FY2026")
//   holding two independent sub-cycles (Mid-Year, Annual), each with its own
//   open/close status and date window — mirrors how the spec ties both
//   reviews to a single year for trend/history purposes while still letting
//   HR open/close them separately.
// - PerformanceReview snapshots org context (department/unit/position/level/
//   band/branch/contractType/gender) at creation time instead of joining
//   live through Employee. Reviews are permanent history per the spec
//   ("never be overwritten"); if a later reorg moves the employee to a new
//   department, past reviews must keep reporting the department they were
//   actually in at the time, exactly like PositionHistory already does for
//   position/band. `reviewerId` is likewise a snapshot of who conducted the
//   review, not a live lookup — reporting lines change, the historical
//   record of who actually reviewed someone should not.
// - Access control (Manager sees direct reports, Department Head sees their
//   department, Admin sees everything) is computed at query time in
//   PerformanceReviewsService from the existing Position.reportsToPositionId
//   tree — no new role column, consistent with how reporting managers are
//   already resolved for Leave approvals.
// - PerformanceAuditLog is an explicit, append-only trail (create/update/
//   submit/acknowledge/finalize/reassign) separate from updatedAt, since the
//   spec requires "every performance review action" to be recorded, not just
//   the most recent change.
// =============================================================================

enum PerformanceReviewType {
  MID_YEAR
  ANNUAL
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  FINALIZED
}

/// Data-driven 1-5 rating scale labels (Outstanding..Unsatisfactory by
/// default) — admin-editable, same pattern as Band/PositionLevel. See the
/// module design note above for why PerformanceReview.overallRating stores
/// the rank directly rather than a foreign key to this table.
model PerformanceRatingScale {
  id          String  @id @default(uuid()) @db.Uuid
  rank        Int     @unique
  label       String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("performance_rating_scales")
}

/// One row per performance year, containing two independently opened/closed
/// sub-cycles. HR creates this, then opens/closes each cycle when ready.
model PerformanceReviewPeriod {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique // e.g. "FY2026"
  year Int    @unique

  midYearStatus   PerformanceCycleStatus @default(DRAFT)
  midYearOpensAt  DateTime?
  midYearClosesAt DateTime?

  annualStatus   PerformanceCycleStatus @default(DRAFT)
  annualOpensAt  DateTime?
  annualClosesAt DateTime?

  reviews PerformanceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("performance_review_periods")
}

/// A single Mid-Year or Annual review for one employee within one period.
/// Org-context fields are a point-in-time snapshot (see design note above),
/// not a live join — this is what makes "performance history should never
/// be overwritten" hold even as the org chart changes underneath it.
model PerformanceReview {
  id         String                @id @default(uuid()) @db.Uuid
  periodId   String                @db.Uuid
  employeeId String
  reviewType PerformanceReviewType
  status     PerformanceReviewStatus @default(DRAFT)

  reviewerId String? // manager who conducted the review (snapshot)

  // --- Snapshot of employee's org context at review time ---
  departmentId String?       @db.Uuid
  unitId       String?       @db.Uuid
  positionId   String?       @db.Uuid
  levelId      String?       @db.Uuid
  bandId       String?       @db.Uuid
  branchId     String?       @db.Uuid
  contractType ContractType?
  gender       Gender?

  // --- Performance Assessment ---
  overallRating          Int? // 1-5, see PerformanceRatingScale for labels
  strengths              String?
  achievements           String?
  areasForImprovement    String?
  goalsAchieved          String?
  goalsNotAchieved       String?
  behaviourCompetencies  String?
  recommendedTraining    String?
  developmentPlan        String?

  // --- Comments ---
  managerComments  String?
  employeeComments String?
  hrComments       String?

  submittedAt    DateTime?
  acknowledgedAt DateTime?
  finalizedAt    DateTime?

  period     PerformanceReviewPeriod @relation(fields: [periodId], references: [id])
  employee   Employee                @relation("PerformanceSubject", fields: [employeeId], references: [employeeNumber])
  reviewer   Employee?               @relation("PerformanceReviewer", fields: [reviewerId], references: [employeeNumber])
  department Department?             @relation(fields: [departmentId], references: [id])
  unit       Unit?                   @relation(fields: [unitId], references: [id])
  position   Position?               @relation(fields: [positionId], references: [id])
  level      PositionLevel?          @relation(fields: [levelId], references: [id])
  band       Band?                   @relation(fields: [bandId], references: [id])
  branch     Branch?                 @relation(fields: [branchId], references: [id])

  auditLogs PerformanceAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId, reviewType])
  @@index([employeeId])
  @@index([departmentId])
  @@index([branchId])
  @@map("performance_reviews")
}

/// Append-only audit trail — every create/update/submit/acknowledge/
/// finalize/reassign action on a review is recorded here, separate from
/// updatedAt, per the spec's "every performance review action must be
/// recorded in the audit log" requirement.
model PerformanceAuditLog {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  action   String // e.g. CREATED, UPDATED, SUBMITTED, ACKNOWLEDGED, FINALIZED, REASSIGNED
  actorId  String? // employee who performed the action (null = system)
  notes    String?

  review PerformanceReview @relation(fields: [reviewId], references: [id])
  actor  Employee?         @relation(fields: [actorId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
  @@map("performance_audit_logs")
}

// =============================================================================
// Learning & Development
//
// Design notes:
// - TrainingCategory is a flat, data-driven lookup (name + isMandatory flag),
//   same "HR can add more without a code change" pattern as Band/PositionLevel
//   — the spec's "Mandatory Training / Non-Mandatory Training" split is just
//   this boolean, and "Regulatory Training" / "AML" / "Leadership" etc. are
//   all simply categories, no rigid multi-level hierarchy imposed.
// - Course's `required*` fields are all independently optional — a course
//   with every one left null is open to everyone; setting any of them
//   restricts eligibility to employees matching *all* the ones that are set
//   (see CoursesService.isEligible / findEligibleEmployees). Mirrors how
//   PerformanceReview snapshots org-context rather than joining live: an
//   employee's eligibility is (re)checked at assignment time, not stored.
// - CourseAssignment is the actual enrollment record (the spec's "Learning
//   Plan" is just a per-employee view over these rows, not a separate
//   table). `categoryName`/`isMandatory` are snapshotted from the course's
//   category at assignment time so a later category edit never rewrites
//   history — identical reasoning to PerformanceReview's org-context
//   snapshot above.
// - Status is a single linear lifecycle (see CourseAssignmentStatus) with
//   REJECTED as a side-branch that a fresh certificate submission always
//   moves back out of into PENDING_VERIFICATION — deliberately simplified
//   from the spec's literal "Certificate Uploaded" / "Pending HR
//   Verification" as two separate statuses into one PENDING_VERIFICATION
//   status (certificateUploadedAt still records the timestamp separately,
//   so nothing from the spec's audit trail is actually lost).
// - "Overdue" is intentionally NOT a stored status — it's computed at query
//   time from dueDate vs now() for any assignment not yet VERIFIED/CLOSED,
//   exactly like LeaveBalance.remainingDays is always computed, never
//   stored, so it can never drift.
// - autoAssignOnHire + autoAssignDueMonths generalize the spec's "AML must
//   be completed within the first calendar year" requirement into a
//   reusable data-driven rule (per the user's "12 months from hire date"
//   decision) rather than hardcoding "AML" as a magic course name anywhere
//   in code — any course can be flagged this way. See
//   EmployeesService.updateEmploymentDetails, which triggers
//   CourseAssignmentsService.assignAutoHireCourses() the first time
//   employmentStartDate is set.
// =============================================================================

enum CourseDeliveryMethod {
  CLASSROOM
  ONLINE
  HYBRID
}

enum CourseAssignmentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Deliberately simplified from the spec's literal Assigned -> Accepted ->
/// Started -> In Progress -> Completed by Employee -> Certificate Uploaded
/// -> Pending HR Verification -> Verified -> Closed: STARTED/IN_PROGRESS
/// collapse into one IN_PROGRESS (there's no real second employee signal
/// between "started" and "still in progress" — startedAt still records the
/// timestamp separately), and COMPLETED_BY_EMPLOYEE's certificate upload
/// moves straight to PENDING_VERIFICATION (certificateUploadedAt keeps that
/// timestamp too). Nothing from the spec's audit trail is lost, just the
/// number of distinct stored status values. "Overdue" is computed, not
/// stored — see the module doc comment.
enum CourseAssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED_BY_EMPLOYEE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CLOSED
}

/// Training provider (internal or external) a course is delivered through.
model Institution {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  contactEmail String?
  contactPhone String?
  website     String?
  isActive    Boolean @default(true)

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutions")
}

/// Flat, HR-editable category lookup — isMandatory distinguishes regulatory/
/// compliance training from optional professional-development training.
model TrainingCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  isMandatory Boolean @default(false)
  description String?
  isActive    Boolean @default(true)

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("training_categories")
}

/// A course in the catalogue. Eligibility (`required*` fields) is checked
/// live against an employee's current org context whenever an assignment is
/// created or an auto-hire rule runs — see the module doc comment above.
model Course {
  id          String  @id @default(uuid()) @db.Uuid
  /// Auto-generated by CoursesService (CRS-0001, CRS-0002, ...), same
  /// generation approach as Employee.employeeNumber.
  courseCode  String  @unique
  name        String
  description String?

  categoryId    String  @db.Uuid
  institutionId String? @db.Uuid

  /// Whole-currency-unit cost (RWF) — plain Int, same "no Decimal in this
  /// schema yet" simplification already used for Leave's day counts.
  cost Int?
  /// Nullable — used for "Average Training Hours" analytics when known;
  /// not every course (e.g. self-paced online) has a fixed duration.
  durationHours Int?

  deliveryMethod CourseDeliveryMethod
  startDate      DateTime?
  endDate        DateTime?

  // --- Eligibility restrictions (all optional; unset = no restriction on
  // that dimension) ---------------------------------------------------------
  requiredFunctionId     String?      @db.Uuid
  requiredDepartmentId   String?      @db.Uuid
  requiredUnitId         String?      @db.Uuid
  requiredPositionId     String?      @db.Uuid
  requiredLevelId        String?      @db.Uuid
  requiredBandId         String?      @db.Uuid
  requiredContractType   ContractType?

  /// When true, every eligible employee gets this course auto-assigned the
  /// first time their employmentStartDate is set (see module doc comment).
  autoAssignOnHire    Boolean @default(false)
  /// Deadline = employmentStartDate + this many months. Defaults to 12 in
  /// code (CourseAssignmentsService) when left unset, per the "12 months
  /// from hire date" AML rule.
  autoAssignDueMonths Int?

  isActive Boolean @default(true)

  category    TrainingCategory @relation(fields: [categoryId], references: [id])
  institution Institution?     @relation(fields: [institutionId], references: [id])

  requiredFunction   Function?      @relation(fields: [requiredFunctionId], references: [id])
  requiredDepartment Department?    @relation(fields: [requiredDepartmentId], references: [id])
  requiredUnit       Unit?          @relation(fields: [requiredUnitId], references: [id])
  requiredPosition   Position?      @relation(fields: [requiredPositionId], references: [id])
  requiredLevel      PositionLevel? @relation(fields: [requiredLevelId], references: [id])
  requiredBand       Band?          @relation(fields: [requiredBandId], references: [id])

  assignments CourseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([institutionId])
  @@map("courses")
}

/// One row per (course, employee) — the actual enrollment / "Learning Plan"
/// entry, carrying the full assignment-through-verification lifecycle.
model CourseAssignment {
  id         String @id @default(uuid()) @db.Uuid
  courseId   String @db.Uuid
  employeeId String

  assignedById String? // Employee.employeeNumber of the HR admin/manager who assigned it (null = system, e.g. auto-hire rule)
  verifiedById String? // Employee.employeeNumber of the HR admin who verified/rejected the certificate

  // --- Snapshot of the course's category, and the employee's org context,
  // at assignment time (see module doc comment) — same "never rewritten by
  // a later org-chart change" reasoning as PerformanceReview's snapshot.
  // Function isn't snapshotted separately since it's derived via
  // department.functionId, which doesn't change once a department exists.
  categoryName String
  isMandatory  Boolean
  departmentId String?       @db.Uuid
  unitId       String?       @db.Uuid
  positionId   String?       @db.Uuid
  levelId      String?       @db.Uuid
  bandId       String?       @db.Uuid
  branchId     String?       @db.Uuid
  contractType ContractType?

  dueDate                DateTime?
  priority               CourseAssignmentPriority @default(MEDIUM)
  recommendationComment  String?
  reasonForAssignment    String?

  status CourseAssignmentStatus @default(ASSIGNED)

  assignedAt            DateTime  @default(now())
  acceptedAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime? // employee self-reported completion
  certificateUploadedAt  DateTime?
  certificateUrl         String?
  employeeCertificateComment String?
  verifiedAt             DateTime?
  hrVerificationComment  String?
  rejectedAt             DateTime?
  closedAt               DateTime?

  course   Course   @relation(fields: [courseId], references: [id])
  employee Employee @relation("CourseAssignee", fields: [employeeId], references: [employeeNumber])
  assignedBy Employee? @relation("CourseAssigner", fields: [assignedById], references: [employeeNumber])
  verifiedBy Employee? @relation("CourseVerifier", fields: [verifiedById], references: [employeeNumber])

  department Department?    @relation(fields: [departmentId], references: [id])
  unit       Unit?          @relation(fields: [unitId], references: [id])
  position   Position?      @relation(fields: [positionId], references: [id])
  level      PositionLevel? @relation(fields: [levelId], references: [id])
  band       Band?          @relation(fields: [bandId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])

  auditLogs CourseAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([status, dueDate])
  @@index([departmentId])
  @@index([branchId])
  @@map("course_assignments")
}

/// Append-only audit trail — every assignment/accept/start/submit/verify/
/// reject/close action is recorded here, separate from updatedAt, per the
/// spec's "every learning action must be recorded in the audit log"
/// requirement. Identical pattern to PerformanceAuditLog.
model CourseAuditLog {
  id           String  @id @default(uuid()) @db.Uuid
  assignmentId String  @db.Uuid
  action       String // e.g. ASSIGNED, ACCEPTED, STARTED, SUBMITTED, VERIFIED, REJECTED, CLOSED
  actorId      String? // Employee.employeeNumber who performed the action (null = system)
  notes        String?

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id])
  actor      Employee?        @relation(fields: [actorId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([assignmentId, createdAt])
  @@map("course_audit_logs")
}

// =============================================================================
// Recruitment Management
//
// Design notes:
// - WorkforcePlan -> JobRequisition -> ... -> Onboarding mirrors the spec's
//   default lifecycle exactly, but the *stage list itself* is fixed in code
//   (RecruitmentStageName) rather than a fully data-driven, HR-reorderable
//   engine — same simplification trade-off already made for Learning &
//   Development's status lifecycle. What IS configurable per requisition:
//   every stage's planned/actual dates, owner, status, and comments
//   (RecruitmentStageInstance), matching the spec's "Recruitment Timeline"
//   table. RecruitmentStageName merges the workflow diagram's "Offer" +
//   "Offer Acceptance" into one OFFER stage (Offer.status already tracks
//   acceptance separately) and drops "Employee Creation" as its own stage,
//   since that's an automatic terminal action captured by
//   Application.hiredEmployeeNumber / OnboardingTask completion — nothing
//   from the spec's tracked information is lost, just the number of stored
//   stage rows.
// - JobRequisition snapshots departmentId/unitId/functionId/branchId from
//   the chosen (or newly-created) Position at creation time — identical
//   "never rewritten by a later org-chart change" reasoning as
//   PerformanceReview/CourseAssignment's org-context snapshots — so
//   recruitment history and analytics keep reporting the org context a
//   vacancy actually belonged to even if departments are restructured later.
// - "Employment Type" (FULL_TIME/PART_TIME/CONTRACT/INTERNSHIP) is kept as
//   its own enum distinct from the existing ContractType
//   (PERMANENT/TEMPORARY/GRADUATE_TRAINEE/INTERN), matching the spec's
//   explicit dual listing of both fields on WorkforcePlan/JobRequisition/
//   JobPosting — ContractType still governs the eventual Employee record.
// - Candidate is a standalone applicant profile (one per email address) so
//   the same person can apply to multiple postings over time without
//   duplicating their CV/education/experience — Application is the
//   per-posting join row carrying its own status lifecycle.
//   Education/Experience/Certifications/Skills/References are kept as plain
//   text blocks for this pass rather than normalized child tables (same
//   "no premature normalization" simplification as Course.description).
// - Screening stores a single current decision (Shortlist/Reject/Hold/
//   Recommend) per application rather than per-criterion scores — the spec
//   lists evaluation criteria as guidance for the reviewer, not a defined
//   scoring rubric (unlike Assessment, which explicitly has score/maxScore).
// - Interview supports multiple rounds (HR/Technical/Manager/Executive) via
//   one row per round, with InterviewPanelist as the many-to-many join to
//   Employee for the interview panel.
// - Offer.bandId doubles as the spec's "Salary Grade" — Band is already the
//   bank's grading structure (see the Band model above), so no separate
//   salary-grade lookup is introduced.
// - Onboarding is a fixed checklist (OnboardingTaskType, matching the spec's
//   9 example items exactly) rather than data-driven, same simplification
//   trade-off as the stage list. Once every task is marked complete, HR
//   triggers RecruitmentOnboardingService.completeOnboarding(), which calls
//   EmployeesService.create/assignPosition/updateEmploymentDetails directly
//   (reusing the existing Employee Registration wizard's own service methods
//   rather than duplicating that logic) — updateEmploymentDetails already
//   triggers the Learning module's mandatory AML auto-assignment the moment
//   employmentStartDate is set, so onboarding automatically satisfies the
//   spec's "Mandatory AML Training Assigned" checklist item as a side
//   effect of the same call, not a separate integration.
// - RecruitmentAuditLog is a single generic append-only table covering every
//   recruitment entity (entityType + entityId, rather than one audit-log
//   table per entity like Performance/Learning) — a deliberate consolidation
//   given how many distinct entities this module has; still satisfies the
//   spec's "every recruitment activity ... must be recorded" requirement.
// - Access control (Recruiter: requisitions/applications assigned to them;
//   Hiring Manager: their department, auto-derived from the Position tree;
//   Admin: everything) is computed at query time in
//   RecruitmentAccessService, duplicating LearningAccessService/
//   PerformanceAccessService's three-tier model rather than importing it —
//   same cross-module-independence reasoning as those two.
// =============================================================================

enum RecruitmentEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RecruitmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkforcePlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum HiringReason {
  NEW_POSITION
  REPLACEMENT
  EXPANSION
  TEMPORARY_REQUIREMENT
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

/// Fixed set of trackable recruitment stages — see the module doc comment
/// above for how this maps onto (and simplifies) the spec's 14-step
/// workflow diagram and 11-row timeline table.
enum RecruitmentStageName {
  WORKFORCE_PLANNING
  JOB_REQUISITION
  JOB_DESCRIPTION
  APPROVAL
  JOB_POSTING
  APPLICATIONS
  SCREENING
  ASSESSMENT
  INTERVIEWS
  BACKGROUND_CHECK
  OFFER
  ONBOARDING
}

/// "Delayed" is intentionally NOT a stored value — computed at query time by
/// comparing plannedEnd to actualEnd/now(), same "overdue is computed, never
/// stored" pattern as CourseAssignment/LeaveBalance.
enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ScreeningDecision {
  SHORTLIST
  REJECT
  HOLD
  RECOMMEND
}

enum AssessmentType {
  TECHNICAL_TEST
  APTITUDE_TEST
  PRACTICAL_EXERCISE
  PSYCHOMETRIC_ASSESSMENT
  COMPLIANCE_TEST
}

enum AssessmentResult {
  PENDING
  PASS
  FAIL
}

enum InterviewType {
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  MANAGER_INTERVIEW
  EXECUTIVE_INTERVIEW
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  CONSIDER
  DO_NOT_HIRE
}

enum BackgroundCheckType {
  EMPLOYMENT_VERIFICATION
  EDUCATION_VERIFICATION
  CRIMINAL_RECORD_CHECK
  PROFESSIONAL_REFERENCES
  IDENTITY_VERIFICATION
}

enum BackgroundCheckStatus {
  PENDING
  PASSED
  FAILED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum OnboardingTaskType {
  EMPLOYEE_NUMBER_CREATED
  SYSTEM_ACCOUNTS_CREATED
  ID_CARD_ISSUED
  LAPTOP_ASSIGNED
  WORKSPACE_ASSIGNED
  MANDATORY_AML_TRAINING_ASSIGNED
  HR_ORIENTATION_SCHEDULED
  MANAGER_ORIENTATION_SCHEDULED
  DOCUMENTS_SIGNED
}

/// Must be APPROVED before a JobRequisition can be created against it.
model WorkforcePlan {
  id           String  @id @default(uuid()) @db.Uuid
  title        String
  departmentId String  @db.Uuid
  unitId       String? @db.Uuid
  branchId     String  @db.Uuid

  hiringManagerId String
  recruiterId     String

  numberOfPositions Int
  employmentType    RecruitmentEmploymentType
  priority          RecruitmentPriority       @default(MEDIUM)
  expectedHiringDate DateTime?
  businessJustification String
  /// Whole-currency-unit (RWF), same "no Decimal in this schema" pattern as
  /// Course.cost.
  budget Int?

  status           WorkforcePlanStatus @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  rejectionComment String?

  department Department @relation(fields: [departmentId], references: [id])
  unit       Unit?      @relation(fields: [unitId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  hiringManager Employee @relation("PlanHiringManager", fields: [hiringManagerId], references: [employeeNumber])
  recruiter     Employee @relation("PlanRecruiter", fields: [recruiterId], references: [employeeNumber])
  approvedBy    Employee? @relation("PlanApprover", fields: [approvedById], references: [employeeNumber])

  requisitions JobRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@map("workforce_plans")
}

/// Initiates recruitment for one or more vacancies against a Position —
/// either an existing one (positionId set to a pre-existing row) or a brand
/// new one created inline via PositionsService at the same time this
/// requisition is created (see RequisitionsService.create).
model JobRequisition {
  id              String @id @default(uuid()) @db.Uuid
  workforcePlanId String @db.Uuid
  positionId      String @db.Uuid

  // --- Snapshot of the position's org context at requisition time (see
  // module doc comment) ------------------------------------------------------
  departmentId String  @db.Uuid
  unitId       String? @db.Uuid
  functionId   String  @db.Uuid
  bandId       String  @db.Uuid

  reportsToPositionId String? @db.Uuid

  numberOfVacancies Int
  contractType      ContractType
  branchId          String @db.Uuid
  employmentType    RecruitmentEmploymentType
  hiringReason      HiringReason

  requestedById   String
  hiringManagerId String
  recruiterId     String // snapshot from WorkforcePlan.recruiterId, for scoping without an extra join

  priority       RecruitmentPriority @default(MEDIUM)
  targetStartDate DateTime?

  jobDescriptionId String? @db.Uuid

  status           RequisitionStatus @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  rejectionComment String?

  workforcePlan WorkforcePlan  @relation(fields: [workforcePlanId], references: [id])
  position      Position       @relation("RequisitionPosition", fields: [positionId], references: [id])
  reportsToPosition Position?  @relation("RequisitionReportsTo", fields: [reportsToPositionId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])
  function      Function       @relation(fields: [functionId], references: [id])
  band          Band           @relation(fields: [bandId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id])

  requestedBy   Employee  @relation("RequisitionRequester", fields: [requestedById], references: [employeeNumber])
  hiringManager Employee  @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [employeeNumber])
  recruiter     Employee  @relation("RequisitionRecruiter", fields: [recruiterId], references: [employeeNumber])
  approvedBy    Employee? @relation("RequisitionApprover", fields: [approvedById], references: [employeeNumber])

  stages       RecruitmentStageInstance[]
  jobPostings  JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([recruiterId])
  @@map("job_requisitions")
}

/// Reusable job description "template" — created standalone and optionally
/// attached to one or more requisitions over time (see module doc comment).
model JobDescription {
  id          String  @id @default(uuid()) @db.Uuid
  jobTitle    String
  jobSummary  String
  keyResponsibilities   String
  requiredQualifications String
  requiredCertifications String?
  requiredExperience     String?
  requiredSkills         String?
  technicalCompetencies  String?
  behaviouralCompetencies String?

  requiredLevelId    String? @db.Uuid
  requiredBandId     String? @db.Uuid
  reportingManagerId String?
  workLocation       String?

  isActive Boolean @default(true)

  requiredLevel    PositionLevel? @relation(fields: [requiredLevelId], references: [id])
  requiredBand     Band?          @relation(fields: [requiredBandId], references: [id])
  reportingManager Employee?      @relation("JobDescriptionReportingManager", fields: [reportingManagerId], references: [employeeNumber])

  requisitions JobRequisition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_descriptions")
}

/// One row per recruitment stage per requisition — the spec's "Recruitment
/// Timeline" table, plus each stage's owner/status/comments. Created in full
/// (all 12 stages) the moment a JobRequisition is created, so the whole
/// planned timeline is visible immediately (same "create every step up
/// front" pattern as LeaveApproval).
model RecruitmentStageInstance {
  id             String               @id @default(uuid()) @db.Uuid
  requisitionId  String               @db.Uuid
  stage          RecruitmentStageName
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  ownerId        String?
  status         StageStatus          @default(NOT_STARTED)
  comments       String?

  requisition JobRequisition @relation(fields: [requisitionId], references: [id])
  owner       Employee?      @relation("StageOwner", fields: [ownerId], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requisitionId, stage])
  @@map("recruitment_stage_instances")
}

model JobPosting {
  id            String  @id @default(uuid()) @db.Uuid
  requisitionId String  @db.Uuid
  postingTitle  String
  isInternal    Boolean @default(true)
  isExternal    Boolean @default(false)
  closingDate   DateTime
  description     String
  responsibilities String
  qualifications   String
  branchId        String @db.Uuid
  employmentType  RecruitmentEmploymentType
  requiredExperience String?

  status      JobPostingStatus @default(DRAFT)
  publishedAt DateTime?
  closedAt    DateTime?

  requisition JobRequisition @relation(fields: [requisitionId], references: [id])
  branch      Branch         @relation(fields: [branchId], references: [id])

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
  @@index([status])
  @@map("job_postings")
}

/// A standalone applicant profile — one per email address. See module doc
/// comment for why Education/Experience/Certifications/Skills/References
/// are plain text rather than normalized child tables in this pass.
model Candidate {
  id          String  @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  email       String  @unique
  phone       String
  nationality String

  cvUrl          String?
  coverLetterUrl String?
  education      String?
  experience     String?
  certifications String?
  skills         String?
  references     String?

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidates")
}

/// One row per (candidate, jobPosting) — the actual pipeline entry every
/// other recruitment stage (screening, assessments, interviews, background
/// checks, offer, onboarding) hangs off of.
model Application {
  id           String @id @default(uuid()) @db.Uuid
  candidateId  String @db.Uuid
  jobPostingId String @db.Uuid

  status    ApplicationStatus @default(APPLIED)
  appliedAt DateTime          @default(now())

  /// Set once onboarding completes and the real Employee record is created
  /// (see RecruitmentOnboardingService.completeOnboarding) — links this
  /// pipeline entry to the resulting employee. Null for every application
  /// that hasn't reached that point (including rejected/withdrawn ones).
  hiredEmployeeNumber String? @unique

  candidate  Candidate  @relation(fields: [candidateId], references: [id])
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])
  hiredEmployee Employee? @relation(fields: [hiredEmployeeNumber], references: [employeeNumber])

  screening        Screening?
  assessments      Assessment[]
  interviews       Interview[]
  backgroundChecks BackgroundCheck[]
  offers           Offer[]
  onboardingTasks  OnboardingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobPostingId])
  @@index([jobPostingId, status])
  @@map("applications")
}

/// Current screening decision for an application — see module doc comment
/// for why this is a single decision rather than per-criterion scores.
model Screening {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @unique @db.Uuid
  decision      ScreeningDecision
  comments      String?
  screenedById  String
  screenedAt    DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  screenedBy  Employee    @relation("ScreeningDecider", fields: [screenedById], references: [employeeNumber])

  @@map("screenings")
}

model Assessment {
  id             String           @id @default(uuid()) @db.Uuid
  applicationId  String           @db.Uuid
  assessmentType AssessmentType
  scheduledDate  DateTime?
  score          Int?
  maxScore       Int?
  result         AssessmentResult @default(PENDING)
  evaluatorId    String?
  comments       String?

  application Application @relation(fields: [applicationId], references: [id])
  evaluator   Employee?   @relation("AssessmentEvaluator", fields: [evaluatorId], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("assessments")
}

model Interview {
  id            String                   @id @default(uuid()) @db.Uuid
  applicationId String                   @db.Uuid
  interviewType InterviewType
  /// Combined date + time, single field (matches how the rest of this schema
  /// stores DateTime rather than separate date/time columns).
  interviewDate DateTime
  location      String?
  notes         String?
  recommendation InterviewRecommendation?
  status        InterviewStatus          @default(SCHEDULED)

  application Application         @relation(fields: [applicationId], references: [id])
  panelists   InterviewPanelist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("interviews")
}

/// Many-to-many join — the spec's "Interview Panel".
model InterviewPanelist {
  id          String @id @default(uuid()) @db.Uuid
  interviewId String @db.Uuid
  employeeId  String

  interview Interview @relation(fields: [interviewId], references: [id])
  employee  Employee  @relation("InterviewPanelist", fields: [employeeId], references: [employeeNumber])

  @@unique([interviewId, employeeId])
  @@map("interview_panelists")
}

model BackgroundCheck {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  checkType     BackgroundCheckType
  status        BackgroundCheckStatus @default(PENDING)
  comments      String?
  completedAt   DateTime?

  application Application @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("background_checks")
}

/// bandId doubles as the spec's "Salary Grade" — see module doc comment.
model Offer {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid

  // --- Snapshot, mirrors JobRequisition's org-context snapshot -------------
  positionId   String @db.Uuid
  departmentId String @db.Uuid
  branchId     String @db.Uuid

  contractType       ContractType
  bandId             String    @db.Uuid
  proposedStartDate  DateTime
  expiryDate         DateTime
  offerLetterUrl     String?

  status     OfferStatus @default(DRAFT)
  sentAt     DateTime?
  respondedAt DateTime?

  createdById String

  application Application @relation(fields: [applicationId], references: [id])
  position    Position    @relation(fields: [positionId], references: [id])
  department  Department  @relation(fields: [departmentId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  band        Band        @relation(fields: [bandId], references: [id])
  createdBy   Employee    @relation("OfferCreator", fields: [createdById], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([status])
  @@map("offers")
}

/// Fixed onboarding checklist (see module doc comment) — once every task for
/// an application is complete, RecruitmentOnboardingService.completeOnboarding
/// creates the real Employee record.
model OnboardingTask {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  taskType      OnboardingTaskType
  isCompleted   Boolean            @default(false)
  completedAt   DateTime?
  completedById String?
  notes         String?

  application Application @relation(fields: [applicationId], references: [id])
  completedBy Employee?   @relation("OnboardingTaskCompleter", fields: [completedById], references: [employeeNumber])

  @@unique([applicationId, taskType])
  @@map("onboarding_tasks")
}

/// Single generic append-only audit trail covering every recruitment entity
/// — see module doc comment for why this deviates from the one-audit-table-
/// per-entity pattern used by Performance/Learning.
model RecruitmentAuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  entityType String // e.g. "WorkforcePlan", "JobRequisition", "Application", "Offer"
  entityId   String
  action     String // e.g. CREATED, APPROVED, REJECTED, STATUS_CHANGED
  actorId    String?
  notes      String?

  actor Employee? @relation("RecruitmentAuditActor", fields: [actorId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("recruitment_audit_logs")
}

// =============================================================================
// Forms Management
//
// Design notes (mirrors the simplification pattern established by
// Recruitment Management above — see that section's doc comment for the
// general reasoning):
//
// - Form Builder is a CONFIGURABLE FIELD LIST, not a drag-and-drop canvas
//   with conditional/branching logic. HR picks a field type from the
//   FieldType catalog, sets label/required/order, and (for
//   DROPDOWN/RADIO/CHECKBOX/MULTI_SELECT/TABLE) its options/columns. There is
//   no "hide field X unless field Y = Z" rule engine.
// - FormField.options and FormField.tableColumns / FormFieldResponse.value
//   are Json — the one deliberate exception to this schema's usual "no
//   exotic types" convention. A form-builder field's shape is inherently
//   per-field-type and open-ended (a dropdown's options, a table's rows, a
//   date-range's two dates, a multi-select's array of picks all need
//   different shapes), so a normalized column-per-type design would need a
//   dozen nullable columns on FormFieldResponse instead of one.
// - Signature routing is an ORDERED LIST OF STAGES (FormSignatureStage), not
//   a fully configurable workflow graph. Stages sharing the same stageOrder
//   sign in PARALLEL; a stage only becomes actionable once every stage at
//   the previous stageOrder is fully signed — this covers the spec's
//   "Employee -> Manager -> Dept Head -> HR" (sequential, 4 distinct
//   stageOrder values) and "Manager + HR + Compliance" (parallel, 3 stages
//   sharing one stageOrder) examples without a graph/branching engine.
// - MANAGER/HEAD_OF_DEPARTMENT/EMPLOYEE signer stages are auto-resolved to a
//   real Employee at FormInstance-creation time (reusing
//   EmployeesService.getReportingManager for MANAGER, and a best-effort
//   "position with no reportsToPositionId in this department" heuristic for
//   HEAD_OF_DEPARTMENT — same org-chart-derivation spirit as Performance/
//   Learning/Recruitment's department-head logic, not authoritative HR
//   policy). HR/EXECUTIVE_MANAGEMENT/unassigned SPECIFIC_APPROVER stages are
//   left with signerId = null until the submitting employee (or HR) picks a
//   real person — see FormSignature.signerId and the spec's "select
//   required signatories" completion step.
// - Form Tables (Education Details, Previous Employment, etc.) are a
//   FieldType.TABLE field whose FormFieldResponse.value holds a JSON array
//   of row objects shaped by that field's tableColumns — there's no
//   separate relational "table row" model, consistent with the Json
//   decision above.
// - Versioning: FormTemplate.rootTemplateId groups every version of the same
//   logical form together (the first version IS the root — its own id).
//   FormTemplatesService blocks editing fields/stages once a template has
//   any FormInstance; publishing a change instead calls createNewVersion(),
//   which clones the fields/stages into a new DRAFT row at version + 1 and
//   archives the old one. FormInstance.formVersion snapshots which version
//   an employee actually completed, so a historical instance's meaning
//   never shifts under a later edit.
// - Reports/exports are ON-SCREEN DASHBOARDS ONLY for aggregate reporting
//   (completion rate, pending signatures, department comparison, etc.) —
//   this pass's PDF export is per-FormInstance only (a single completed
//   form's data + signatures), not the aggregate Excel/CSV/PowerPoint
//   report files the spec describes.
// - Single generic append-only audit trail (FormAuditLog), same
//   entityType/entityId consolidation as RecruitmentAuditLog, for the same
//   reason: this module has many distinct entities (template, instance,
//   signature) to audit.
// =============================================================================

enum FormStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  COMMENTS
  NUMBER
  AMOUNT
  PERCENTAGE
  DATE
  DATE_RANGE
  DROPDOWN
  RADIO
  CHECKBOX
  MULTI_SELECT
  EMPLOYEE_SELECT
  DEPARTMENT_SELECT
  POSITION_SELECT
  MANAGER_SELECT
  FILE_UPLOAD
  CERTIFICATE_UPLOAD
  ATTACHMENT_UPLOAD
  APPROVAL_DECISION
  RECOMMENDATION
  TABLE
}

enum SignerRole {
  EMPLOYEE
  MANAGER
  HEAD_OF_DEPARTMENT
  HR
  EXECUTIVE_MANAGEMENT
  SPECIFIC_APPROVER
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
  RETURNED_FOR_CORRECTION
}

enum FormInstanceStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  PENDING_SIGNATURES
  REJECTED
  COMPLETED
  ARCHIVED
}

enum FormPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// HR-manageable form category (Recruitment Forms, Employee Forms,
/// Compliance Forms, Exit Forms, or any future custom category) — same
/// data-driven-lookup pattern as TrainingCategory/Institution.
model FormCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  templates FormTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("form_categories")
}

model FormTemplate {
  id                         String     @id @default(uuid()) @db.Uuid
  title                      String
  formCode                   String     @unique
  description                String
  purpose                    String?
  categoryId                 String     @db.Uuid
  requirementsInstructions   String?
  applicableDepartmentId     String?    @db.Uuid
  /// Informational only in this pass — not enforced as an eligibility
  /// filter at assignment time (unlike Course's requiredX restrictions).
  applicableEmployeeCategory String?
  status                     FormStatus @default(DRAFT)
  version                    Int        @default(1)
  /// See module doc comment — null on the root version itself.
  rootTemplateId             String?    @db.Uuid

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category             FormCategory @relation(fields: [categoryId], references: [id])
  applicableDepartment Department?  @relation(fields: [applicableDepartmentId], references: [id])
  createdBy            Employee     @relation("FormTemplateCreator", fields: [createdById], references: [employeeNumber])
  rootTemplate         FormTemplate?  @relation("FormTemplateVersions", fields: [rootTemplateId], references: [id])
  laterVersions        FormTemplate[] @relation("FormTemplateVersions")

  fields          FormField[]
  signatureStages FormSignatureStage[]
  instances       FormInstance[]

  @@index([categoryId])
  @@index([status])
  @@index([rootTemplateId])
  @@map("form_templates")
}

model FormField {
  id             String    @id @default(uuid()) @db.Uuid
  formTemplateId String    @db.Uuid
  fieldType      FieldType
  label          String
  helpText       String?
  isRequired     Boolean   @default(false)
  order          Int
  /// JSON array of {value,label} — DROPDOWN/RADIO/CHECKBOX/MULTI_SELECT only.
  options        Json?
  /// JSON array of {key,label,type} — TABLE fields only.
  tableColumns   Json?

  formTemplate FormTemplate        @relation(fields: [formTemplateId], references: [id])
  responses    FormFieldResponse[]

  @@index([formTemplateId])
  @@map("form_fields")
}

/// One row per signer/parallel-signer-slot in a form's approval chain — see
/// module doc comment for the "stages sharing stageOrder sign in parallel"
/// rule.
model FormSignatureStage {
  id                 String     @id @default(uuid()) @db.Uuid
  formTemplateId     String     @db.Uuid
  stageOrder         Int
  role               SignerRole
  /// Fixed signer for SPECIFIC_APPROVER stages that are always the same
  /// person; null when the submitting employee picks the signer themselves.
  specificApproverId String?
  label              String?

  formTemplate     FormTemplate    @relation(fields: [formTemplateId], references: [id])
  specificApprover Employee?       @relation("FormStageSpecificApprover", fields: [specificApproverId], references: [employeeNumber])
  signatures       FormSignature[]

  @@index([formTemplateId, stageOrder])
  @@map("form_signature_stages")
}

model FormInstance {
  id             String   @id @default(uuid()) @db.Uuid
  formTemplateId String   @db.Uuid
  /// Snapshot of FormTemplate.version at assignment time.
  formVersion    Int
  employeeId     String
  assignedById   String

  assignmentDate DateTime  @default(now())
  dueDate        DateTime?
  instructions   String?
  priority       FormPriority        @default(MEDIUM)
  status         FormInstanceStatus  @default(ASSIGNED)

  submittedAt      DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  rejectionComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [id])
  employee     Employee     @relation("FormInstanceEmployee", fields: [employeeId], references: [employeeNumber])
  assignedBy   Employee     @relation("FormInstanceAssigner", fields: [assignedById], references: [employeeNumber])

  responses  FormFieldResponse[]
  signatures FormSignature[]

  @@index([employeeId, status])
  @@index([status, dueDate])
  @@map("form_instances")
}

model FormFieldResponse {
  id             String @id @default(uuid()) @db.Uuid
  formInstanceId String @db.Uuid
  formFieldId    String @db.Uuid
  /// Shape depends on the field's FieldType — see module doc comment.
  value          Json?

  formInstance FormInstance @relation(fields: [formInstanceId], references: [id])
  formField    FormField    @relation(fields: [formFieldId], references: [id])

  @@unique([formInstanceId, formFieldId])
  @@map("form_field_responses")
}

model FormSignature {
  id                   String @id @default(uuid()) @db.Uuid
  formInstanceId       String @db.Uuid
  formSignatureStageId String @db.Uuid
  /// Null until resolved/chosen — see module doc comment.
  signerId             String?
  status               SignatureStatus @default(PENDING)
  signedAt             DateTime?
  comments             String?
  ipAddress            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formInstance       FormInstance       @relation(fields: [formInstanceId], references: [id])
  formSignatureStage FormSignatureStage @relation(fields: [formSignatureStageId], references: [id])
  signer             Employee?          @relation("FormSigner", fields: [signerId], references: [employeeNumber])

  @@unique([formInstanceId, formSignatureStageId])
  @@index([signerId, status])
  @@map("form_signatures")
}

/// Single generic append-only audit trail covering every Forms entity — see
/// module doc comment.
model FormAuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  action     String
  actorId    String?
  notes      String?

  actor Employee? @relation("FormAuditActor", fields: [actorId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("form_audit_logs")
}

// =============================================================================
// EMPLOYEE RELATIONS MODULE
//
// Covers disciplinary cases, investigations, sanctions, employee grievances,
// and appeals — HR's confidential system of record for employee conduct
// matters, per the NCBA Rwanda PeopleSuite spec. Simplification/design
// decisions made explicit here (mirroring the Forms Management section's
// style above), several confirmed directly with the user before this module
// was built:
// - CONFIDENTIALITY: DisciplinaryCase.isConfidential is a per-case flag HR
//   sets (e.g. for sensitive harassment/fraud matters). A non-confidential
//   case is visible to the subject employee's line manager; a confidential
//   case is HR/Executive (isAdmin) only regardless of reporting line — see
//   EmployeeRelationsAccessService. This was an explicit user choice over
//   two simpler alternatives (managers always see their reports' cases, or
//   managers never see any case).
// - LINE MANAGER = DIRECT REPORT ONLY, not the whole org subtree: resolved
//   the same way EmployeesService.getReportingManager() resolves upward
//   (reportingManagerOverride first, else position.reportsToPositionId) —
//   EmployeeRelationsAccessService does the inverse lookup. No caching/
//   materialized-subtree table; this is a live query, same performance
//   profile as the rest of this schema's org-chart-derived logic.
// - SANCTION APPROVAL is a RECORDED FIELD, not an enforced workflow gate:
//   Sanction.issuedById/approvalAuthorityId simply record who signed off,
//   per HR's own paper-trail process — there's no Forms-Management-style
//   signature-stage gate blocking a sanction from taking effect. Explicit
//   user choice, matching the spec's literal field list (it lists
//   "Approval Authority" as a sanction field, not as a workflow step).
// - REPORTS/EXPORTS are ON-SCREEN DASHBOARDS ONLY for aggregate analytics
//   (case counts, sanction analysis, department/branch comparisons, trends)
//   plus a per-case PDF export (the full case + investigation + sanction +
//   appeal record) — not the aggregate Excel/CSV/PowerPoint report files or
//   auto-generated executive decks the spec describes. Same "on-screen +
//   single-record PDF" precedent set for Recruitment and Forms Management,
//   confirmed with the user for this module too.
// - ORG-CONTEXT ANALYTICS (department/branch/function/level/band slicing)
//   are computed at query time from the employee's CURRENT position/branch,
//   not snapshotted onto the case/sanction at creation time the way
//   PerformanceReview snapshots org context. This trades point-in-time
//   historical precision (a transferred employee's old cases bucket under
//   their current department, not their department at the time) for a much
//   smaller schema surface — same simplification already used by Forms
//   Management's department-comparison analytics. Acceptable for on-screen
//   dashboards; revisit with real snapshot columns if audit-grade
//   point-in-time department attribution is ever required.
// - CASE CATEGORY and GRIEVANCE CATEGORY are closed enums, not HR-
//   configurable lookup tables — the spec only calls out SANCTION TYPES as
//   needing future configurability ("HR Administrators should be able to
//   configure additional sanction types... without changing the
//   application"), so only SanctionType gets the FormCategory/
//   TrainingCategory-style configurable-lookup treatment.
// - "Supporting Evidence"/"Supporting Documents"/"Witnesses" fields are
//   plain Postgres string arrays (`String[]`) rather than a generic
//   Document join model or JSON — each is just a flat list of URLs (or
//   witness names), so a native scalar list is simpler than either
//   alternative and needs no extra model.
// - DISCIPLINARY MEETINGS are a lightweight new model (not explicitly
//   itemized under "Case Information" in the spec, but required by the
//   Notifications section: "Employees when: A disciplinary meeting is
//   scheduled") — one row per scheduled meeting, linked to its case.
// - "Investigations overdue" / "cases unresolved beyond timeframe" are
//   surfaced as COMPUTED DASHBOARD METRICS (Investigation.dueDate vs now,
//   case age vs a threshold), not as scheduled background-job notifications
//   — this codebase has no job scheduler (no @nestjs/schedule dependency),
//   the same reasoning already documented for CourseAssignment/FormInstance
//   "overdue" being computed-not-stored. The ERC_INVESTIGATION_OVERDUE
//   notification type exists for completeness/future use but isn't fired
//   by a cron in this pass.
// - CaseNumber/GrievanceNumber use the exact same generation pattern as
//   EmployeesService's employeeNumber allocator: scan existing rows for the
//   current year's prefix, take the max numeric suffix, increment, pad to 4
//   digits (e.g. "ERC-2026-0001", "GRV-2026-0001").
// - Single generic append-only audit trail (EmployeeRelationsAuditLog),
//   same entityType/entityId consolidation as FormAuditLog/
//   RecruitmentAuditLog, covering every distinct entity this module has
//   (case, meeting, investigation, sanction, grievance, appeal).
// - Sanction.employeeId is DENORMALIZED from its DisciplinaryCase (rather
//   than reached only via case.employeeId) specifically so "permanent
//   sanction history for an employee" (a named spec requirement) is a
//   direct, simple query — not a join through cases — and remains correct
//   even in the hypothetical future where a case's employee association
//   might need correction without rewriting sanction history.
// =============================================================================

enum DisciplinaryCaseCategory {
  MISCONDUCT
  ATTENDANCE
  INSUBORDINATION
  HARASSMENT
  DISCRIMINATION
  FRAUD
  POLICY_VIOLATION
  SAFETY_VIOLATION
  PERFORMANCE_ISSUE
  CONFIDENTIALITY_BREACH
  OTHER
}

enum DisciplinaryCaseStatus {
  DRAFT
  UNDER_INVESTIGATION
  PENDING_DECISION
  SANCTION_ISSUED
  CLOSED
  APPEALED
}

enum InvestigationStatus {
  IN_PROGRESS
  COMPLETED
}

enum GrievanceCategory {
  WORKPLACE_CONFLICT
  HARASSMENT
  DISCRIMINATION
  COMPENSATION
  WORKING_CONDITIONS
  MANAGEMENT_CONDUCT
  POLICY_DISPUTE
  OTHER
}

enum GrievanceStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  DECIDED
}

enum AppealOutcome {
  UPHELD
  OVERTURNED
  MODIFIED
}

/// HR-configurable sanction type (Verbal Warning, Written Warning, Final
/// Written Warning, Suspension, Demotion, Salary Reduction, Termination, or
/// any future custom type) — same data-driven-lookup pattern as
/// FormCategory/TrainingCategory/Institution.
model SanctionType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  sanctions Sanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sanction_types")
}

model DisciplinaryCase {
  id                     String                   @id @default(uuid()) @db.Uuid
  caseNumber             String                   @unique
  employeeId             String
  reportedById           String
  dateReported           DateTime                 @default(now())
  incidentDate           DateTime
  incidentLocation       String?
  category               DisciplinaryCaseCategory
  subject                String
  description            String
  supportingDocumentUrls String[]                 @default([])
  witnesses              String[]                 @default([])
  investigationRequired  Boolean                  @default(false)
  status                 DisciplinaryCaseStatus   @default(DRAFT)
  /// See module doc comment — gates line-manager visibility regardless of
  /// reporting line when true.
  isConfidential         Boolean                  @default(false)
  closedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee @relation("DisciplinaryCaseEmployee", fields: [employeeId], references: [employeeNumber])
  reportedBy Employee @relation("DisciplinaryCaseReporter", fields: [reportedById], references: [employeeNumber])

  meetings       DisciplinaryMeeting[]
  investigations Investigation[]
  sanctions      Sanction[]
  appeals        Appeal[]

  @@index([employeeId, status])
  @@index([status])
  @@map("disciplinary_cases")
}

/// A scheduled disciplinary hearing/meeting for a case — see module doc
/// comment (added to support the spec's "disciplinary meeting scheduled"
/// employee notification).
model DisciplinaryMeeting {
  id                 String   @id @default(uuid()) @db.Uuid
  disciplinaryCaseId String   @db.Uuid
  scheduledAt        DateTime
  location           String?
  notes              String?
  createdById        String

  disciplinaryCase DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id])
  createdBy        Employee         @relation("MeetingCreator", fields: [createdById], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([disciplinaryCaseId])
  @@map("disciplinary_meetings")
}

/// Permanently linked to its DisciplinaryCase — see module doc comment.
model Investigation {
  id                     String               @id @default(uuid()) @db.Uuid
  disciplinaryCaseId     String               @db.Uuid
  investigatorId         String
  startDate              DateTime
  endDate                DateTime?
  /// HR-set expected completion date — drives the "investigations overdue"
  /// dashboard metric (see module doc comment; not a scheduled notification).
  dueDate                DateTime?
  status                 InvestigationStatus  @default(IN_PROGRESS)
  summary                String?
  findings               String?
  supportingDocumentUrls String[]             @default([])
  recommendation         String?

  disciplinaryCase DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id])
  investigator     Employee         @relation("Investigator", fields: [investigatorId], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disciplinaryCaseId])
  @@map("investigations")
}

/// Permanent sanction history — see module doc comment on why employeeId is
/// denormalized here rather than reached only through disciplinaryCase.
model Sanction {
  id                     String   @id @default(uuid()) @db.Uuid
  disciplinaryCaseId     String   @db.Uuid
  employeeId             String
  sanctionTypeId         String   @db.Uuid
  dateOfSanction         DateTime @default(now())
  reason                 String
  effectiveDate          DateTime
  issuedById             String
  /// Recorded field only — see module doc comment on sanction approval.
  approvalAuthorityId    String?
  comments               String?
  supportingDocumentUrls String[] @default([])

  disciplinaryCase  DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id])
  employee          Employee         @relation("SanctionEmployee", fields: [employeeId], references: [employeeNumber])
  sanctionType       SanctionType    @relation(fields: [sanctionTypeId], references: [id])
  issuedBy          Employee         @relation("SanctionIssuer", fields: [issuedById], references: [employeeNumber])
  approvalAuthority Employee?        @relation("SanctionApprover", fields: [approvalAuthorityId], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([disciplinaryCaseId])
  @@index([sanctionTypeId])
  @@map("sanctions")
}

/// Employee-submitted grievance — HR-only visibility (+ the submitter), see
/// EmployeeRelationsAccessService.
model Grievance {
  id                     String            @id @default(uuid()) @db.Uuid
  grievanceNumber        String            @unique
  employeeId             String
  dateSubmitted          DateTime          @default(now())
  subject                String
  description            String
  category               GrievanceCategory
  supportingDocumentUrls String[]          @default([])
  status                 GrievanceStatus   @default(SUBMITTED)
  assignedToId           String?
  resolutionComments     String?
  resolvedAt             DateTime?

  employee   Employee  @relation("GrievanceSubmitter", fields: [employeeId], references: [employeeNumber])
  assignedTo Employee? @relation("GrievanceAssignee", fields: [assignedToId], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("grievances")
}

/// An appeal against a disciplinary case's outcome — stays permanently
/// linked to the original case (see module doc comment).
model Appeal {
  id                     String        @id @default(uuid()) @db.Uuid
  disciplinaryCaseId     String        @db.Uuid
  employeeId             String
  appealDate             DateTime      @default(now())
  appealReason           String
  supportingDocumentUrls String[]      @default([])
  status                 AppealStatus  @default(SUBMITTED)
  outcome                AppealOutcome?
  decisionDate           DateTime?
  decisionComments       String?
  decidedById            String?

  disciplinaryCase DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id])
  employee         Employee         @relation("AppealEmployee", fields: [employeeId], references: [employeeNumber])
  decidedBy        Employee?        @relation("AppealDecider", fields: [decidedById], references: [employeeNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disciplinaryCaseId])
  @@index([employeeId])
  @@map("appeals")
}

/// Single generic append-only audit trail covering every Employee Relations
/// entity — same entityType/entityId consolidation as FormAuditLog/
/// RecruitmentAuditLog, for the same reason (many distinct entities: case,
/// meeting, investigation, sanction, grievance, appeal).
model EmployeeRelationsAuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  action     String
  actorId    String?
  notes      String?

  actor Employee? @relation("ERAuditActor", fields: [actorId], references: [employeeNumber])

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("employee_relations_audit_logs")
}
